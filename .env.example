PORT=3300
NODE_ENV=production
APP_PASSWORD=ganti-password-akses
SESSION_SECRET=ganti-dengan-random-secret-minimal-32-karakter
SESSION_DAYS=7
GEMINI_API_KEY=masukkan-api-key-gemini
GEMINI_MODEL=gemini-3.8-flash

# Default gratis untuk live web search
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=masukkan-api-key-tavily
MAX_UPLOAD_MB=20
MAX_COMPARABLES=12
